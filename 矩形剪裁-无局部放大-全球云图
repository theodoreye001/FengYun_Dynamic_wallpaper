<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>矩形地球图像显示</title>
    <meta http-equiv="refresh" content="1800">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            background-color: #000000;
            height: 100%;
            overflow: hidden;
        }
        .earth-image {
            width: 100%;
            height: 100%;
            background: no-repeat center;
            background-size: contain;
        }
    </style>
</head>
<body>
    <div class="earth-image"></div>
    <script>
        function getAlignedUrl() {
            const now = new Date();
            const year = now.getUTCFullYear();
            const month = String(now.getUTCMonth() + 1).padStart(2, '0');
            const day = String(now.getUTCDate()).padStart(2, '0');
            const hour = String(now.getUTCHours()).padStart(2, '0');
            const dateStr = `${year}${month}${day}`;
            const timeStr = `${hour}00`;
            return `https://img.nsmc.org.cn/CLOUDIMAGE/GEOS/MOS/IRX/PIC/GBAL/GEOS_IMAGR_GBAL_L2_MOS_IRX_GLL_${dateStr}_${timeStr}_10KM_MS.jpg`;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const earthImage = document.querySelector('.earth-image');
            earthImage.style.backgroundImage = `url(${getAlignedUrl()})`;
        });
    </script>
</body>
</html>
